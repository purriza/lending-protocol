        "maxSizeBytes": 24576,
        "warningThresholdBytes": 20000,
        "description": "Main lending vault contract"
      },
      {
        "name": "LiquidationEngine", 
        "maxSizeBytes": 24576,
        "warningThresholdBytes": 20000,
        "description": "Liquidation engine contract"
      },
      {
        "name": "ProtocolConfig",
        "maxSizeBytes": 24576,
        "warningThresholdBytes": 20000,
        "description": "Protocol configuration contract"
      },
      {
        "name": "StabilityFund",
        "maxSizeBytes": 24576,
        "warningThresholdBytes": 20000,
        "description": "Stability fund contract"
      },
      {
        "name": "Treasury",
        "maxSizeBytes": 24576,
        "warningThresholdBytes": 20000,
        "description": "Treasury contract"
      },
      {
        "name": "PUSD",
        "maxSizeBytes": 24576,
        "warningThresholdBytes": 20000,
        "description": "PUSD token contract"
      }
