  "gasLimits": {
    "criticalOperations": {
      "deposit": {
        "maxGas": 200000,
        "warningThreshold": 150000,
        "description": "Deposit collateral operation"
      },
      "borrow": {
        "maxGas": 300000,
        "warningThreshold": 250000,
        "description": "Borrow PUSD operation"
      },
      "repay": {
        "maxGas": 200000,
        "warningThreshold": 150000,
        "description": "Repay debt operation"
      },
      "withdraw": {
        "maxGas": 200000,
        "warningThreshold": 150000,
        "description": "Withdraw collateral operation"
      },
      "liquidatePosition": {
        "maxGas": 500000,
        "warningThreshold": 400000,
        "description": "Liquidate position operation"
      },
      "executeLiquidation": {
        "maxGas": 400000,
        "warningThreshold": 300000,
        "description": "Execute liquidation operation"
      }
    }
  },
  "monitoring": {
    "enableGasTracking": true,
    "enableSizeTracking": true,
    "generateReports": true,
    "failOnSizeExceed": true,
    "failOnGasExceed": false
  }
